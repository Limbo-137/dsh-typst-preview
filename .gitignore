node_modules/

# Local build config: points pnpm's store/cache at a path on this machine only.
# A clone should use its own defaults, so this file is never committed.
.npmrc

# Scratch directories used by the verification scripts.
.tmp-smoke/
.tmp-leak/
.tmp-render/
.tmp-dsh-home/
cdp-*/

# Packed tarball, if you build a release locally.
*.tgz

.DS_Store
*.log

# pnpm 11 writes install-time supply-chain settings here; not part of the package.
pnpm-workspace.yaml
