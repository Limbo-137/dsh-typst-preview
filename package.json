{
  "name": "dsh-typst-preview",
  "version": "0.3.1",
  "description": "DeepSeek Harness web plugin: live Typst preview as a native right-Sidebar tab, rendered by a per-file `tinymist preview` server proxied over the app origin, with the source face highlighted from tinymist's semantic tokens.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    },
    "compatibility": {
      "dsh": ">=0.1.5-rc.1 <0.2.0",
      "dshReleases": {
        "0.1.5-rc.1": "compatible"
      },
      "profiles": [
        "web"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.5-rc.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.1",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "~5.7.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "leak-check": "node scripts/leak-check.mjs",
    "render-check": "node scripts/render-check.mjs",
    "gui-check": "node scripts/gui-check.mjs"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "src",
    "docs",
    "cordis.patch.yml",
    "screenshots.json"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "typst",
    "tinymist",
    "preview",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Limbo-137/dsh-typst-preview.git"
  },
  "homepage": "https://github.com/Limbo-137/dsh-typst-preview#readme",
  "bugs": {
    "url": "https://github.com/Limbo-137/dsh-typst-preview/issues"
  },
  "author": "Limbo-137",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
